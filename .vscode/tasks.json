{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "game01: local room test (server + client 1001)",
      "type": "shell",
      "command": "server_pid=''; cleanup() { if [ -n \"$server_pid\" ]; then kill \"$server_pid\" 2>/dev/null || true; fi; }; trap cleanup EXIT INT TERM; cargo run --package game01-server & server_pid=$!; for attempt in $(seq 1 100); do if lsof -nP -iUDP:5000 -sUDP:LISTEN >/dev/null 2>&1; then break; fi; if ! kill -0 \"$server_pid\" 2>/dev/null; then wait \"$server_pid\"; exit $?; fi; sleep 0.1; done; if ! lsof -nP -iUDP:5000 -sUDP:LISTEN >/dev/null 2>&1; then echo 'server did not bind UDP port 5000'; exit 1; fi; cargo run --package game01-client --features dev -- 1001",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": ["$rustc"],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "game01"
      },
      "runOptions": {
        "instanceLimit": 1
      }
    },
